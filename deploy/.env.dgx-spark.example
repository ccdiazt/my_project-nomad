# Project N.O.M.A.D. on DGX Spark — copy to deploy/.env and fill in.
#   cp deploy/.env.dgx-spark.example deploy/.env
#
# deploy/.env holds secrets and is gitignored. Do not commit it.

# --- Required ------------------------------------------------------------------------

# At least 16 characters. Generate with: openssl rand -hex 24
APP_KEY=

# The URL you will actually open the Command Center at. Used for generated links,
# so localhost is wrong if you reach the Spark from another machine.
NOMAD_URL=http://192.168.1.50:8080

# Database credentials. Generate with: openssl rand -hex 16
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Paths ---------------------------------------------------------------------------

# Content, models and uploads. Sized for ZIM archives — put it on the NVMe.
NOMAD_STORAGE_PATH=/opt/project-nomad/storage
# Parent for the mysql/ and redis/ data directories.
NOMAD_DATA_PATH=/opt/project-nomad

# --- RAG embedding profile -----------------------------------------------------------
#
# nomic  (default) : nomic-embed-text:v1.5 — 768 dims, 1500-token chunks.
#                    Upstream default, zero changes, English-centric.
# e5               : intfloat/multilingual-e5-base — 768 dims, but a 512-token context,
#                    so chunks shrink to 400 tokens and the corpus yields ~3x more
#                    vectors. Good multilingual retrieval.
# bge-m3           : BAAI/bge-m3 — 1024 dims, 8192-token context, no task prefixes.
#                    Best multilingual quality; needs the Qdrant collection at 1024.
#
# Switching this after ingesting documents requires rebuilding the collection:
#   curl -X DELETE http://localhost:6333/collections/nomad_knowledge_base
RAG_EMBEDDING_PRESET=e5

# Only needed if the backend reports the embedding model under a different name than
# nomic-embed-text:v1.5. With the LiteLLM config in this directory the alias already
# matches, so leave this empty.
RAG_EMBEDDING_MODEL=

# Only for a checkpoint whose dimension differs from its preset (e.g. a Matryoshka model
# truncated to a non-default size). Leave empty otherwise.
RAG_EMBEDDING_DIMENSION=

# --- Misc ----------------------------------------------------------------------------

LOG_LEVEL=info
