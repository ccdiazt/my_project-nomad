PORT=8080
HOST=localhost
LOG_LEVEL=info
# Optional: override the URL used to test internet connectivity.
# Defaults to https://1.1.1.1/cdn-cgi/trace with fallbacks to hosts the app
# already contacts. Leave unset to use the defaults.
# INTERNET_STATUS_TEST_URL=https://1.1.1.1/cdn-cgi/trace
APP_KEY=some_random_key
NODE_ENV=development
SESSION_DRIVER=cookie
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_DATABASE=nomad
DB_PASSWORD=password
DB_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: Redis logical database index (0-15). Defaults to 0 if unset.
# Set this when sharing a Redis instance across services to avoid key collisions.
# REDIS_DB=0
# Storage path for NOMAD content (ZIM files, maps, etc.)
# On Windows dev, use an absolute path like: C:/nomad-storage
# On Linux production, use: /opt/project-nomad/storage
NOMAD_STORAGE_PATH=/opt/project-nomad/storage

# --- RAG embedding profile ---
# Only needed when the AI Assistant points at a backend that doesn't serve
# nomic-embed-text:v1.5 (e.g. vLLM behind an OpenAI-compatible router). The preset picks
# vector dimension, task prefixes and chunk sizing as a set — see constants/rag_embedding.ts.
#   nomic  (default) 768 dims, 1500-token chunks, search_document:/search_query: prefixes
#   e5               768 dims, 400-token chunks (512-token context), passage:/query: prefixes
#   bge-m3           1024 dims, 1500-token chunks, no prefixes
# Changing this after ingesting documents requires rebuilding the Qdrant collection.
# RAG_EMBEDDING_PRESET=nomic
# Name the backend reports for the embedding model, if not nomic-embed-text:v1.5.
# RAG_EMBEDDING_MODEL=nomic-embed-text:v1.5
# Overrides the preset's dimension. Only for Matryoshka checkpoints truncated to a
# non-default size.
# RAG_EMBEDDING_DIMENSION=768